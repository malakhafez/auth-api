DB_HOST=localhost
DB_PORT=5432
DB_USER=postgres
DB_PASSWORD=change_me
DB_NAME=restaurant_go_db

# ---- Auth module ----
# Required: at least 32 random characters (e.g. `openssl rand -base64 48`)
# First-run CEO account (used only if no CEO exists yet; must change password on first login)
JWT_SECRET=
SEED_CEO_NAME=CEO
SEED_CEO_EMAIL=ceo@example.com
SEED_CEO_PASSWORD=ChangeMe12345

# Optional tuning (defaults shown)
# AUTH_ACCESS_TTL=15m
# AUTH_REFRESH_TTL=720h
# AUTH_MAX_FAILED_ATTEMPTS=5
# AUTH_BASE_LOCKOUT=15m
# AUTH_MAX_LOCKOUT=1h
# AUTH_BCRYPT_COST=12
# AUTH_LOGIN_RATE_PER_MIN=10
